<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Zynko — {{ current_user.username if current_user.is_authenticated else 'Chat' }}</title>
<link rel="manifest" href="{{ url_for('static', filename='manifest.json') }}">
<meta name="theme-color" content="#0a0a0f">
<style>
:root{--bg:#0a0a0f;--card:#15101f;--card2:#1f1730;--text:#f5f3ff;--muted:#9a8ec2;--grad:linear-gradient(135deg,#7C3AED 0%,#EC4899 50%,#EF4444 100%);--border:#2a2340}
*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,system-ui,sans-serif}
body{background:var(--bg);color:var(--text);height:100dvh;overflow:hidden}
.app{display:grid;grid-template-columns:360px 1fr;height:100dvh}
.sidebar{background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column}
.topbar{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid var(--border)}
.logo{font-weight:900;font-size:22px;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.logo.s2{background:linear-gradient(#fff,#aaa);-webkit-background-clip:text}
.logo.s3{background:#fff;-webkit-text-fill-color:#000;padding:2px 8px;border-radius:8px}
.logo.s4{background:#000;color:#fff;border:1px solid #333;padding:2px 8px;border-radius:8px;-webkit-text-fill-color:#fff}
.dots{display:flex;gap:6px}.dot{width:22px;height:22px;border-radius:6px;cursor:pointer;border:2px solid transparent}.dot.a{border-color:#fff}
.s1{background:var(--grad)}.s2b{background:#fff}.s3b{background:#fff;color:#000;display:grid;place-items:center;font-weight:900}.s4b{background:#000;border:1px solid #444;display:grid;place-items:center}
.search{margin:10px;background:var(--card2);border-radius:10px;padding:8px 12px;display:flex;gap:6px}.search input{background:transparent;border:0;color:#fff;outline:none;width:100%}
.list{overflow:auto;flex:1}.item{
